<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background">

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@color/primary"
                android:orientation="vertical"
                android:gravity="center">
                <FrameLayout
                    android:layout_width="80dp" android:layout_height="80dp"
                    android:background="@drawable/bg_circle_white">
                    <TextView android:id="@+id/tvInitial"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="J" android:textSize="32sp"
                        android:textStyle="bold" android:textColor="@color/primary"/>
                </FrameLayout>
                <TextView android:id="@+id/tvName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="John Silva" android:textSize="21sp"
                    android:textStyle="bold" android:textColor="@color/white"/>
                <TextView android:id="@+id/tvEmail"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="john@email.com" android:textSize="16sp"
                    android:textColor="#BBDEFB"/>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="12dp" app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvBookingCount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="22sp"
                            android:textStyle="bold" android:textColor="@color/primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Bookings" android:textSize="12sp" android:textColor="@color/text_secondary"/>
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="40dp" android:background="@color/divider"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvActiveRepairs"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="22sp"
                            android:textStyle="bold" android:textColor="@color/primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Active Repairs" android:textSize="12sp" android:textColor="@color/text_secondary"/>
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="40dp" android:background="@color/divider"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:id="@+id/tvDevices"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textSize="22sp"
                            android:textStyle="bold" android:textColor="@color/primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Devices" android:textSize="12sp" android:textColor="@color/text_secondary"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:id="@+id/menuSavedDevices"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="" android:textSize="16sp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Saved Devices"
                            android:textSize="16sp" android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tvSavedDevicesChevron"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary"
                            android:rotation="0"/>
                    </LinearLayout>

                    <!-- Expandable List Container -->
                    <LinearLayout
                        android:id="@+id/layoutSavedDevicesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingBottom="8dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">
                        <!-- Devices will be added here dynamically -->
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginStart="16dp"/>

                    <LinearLayout android:id="@+id/menuMyBookings"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="" android:textSize="16sp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Booking History"
                            android:textSize="16sp" android:textColor="@color/text_primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginStart="16dp"/>

                    <LinearLayout android:id="@+id/menuNotifSettings"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="" android:textSize="16sp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Notification Settings"
                            android:textSize="16sp" android:textColor="@color/text_primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginStart="16dp"/>

                    <LinearLayout android:id="@+id/menuSupport"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="" android:textSize="16sp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="FAQs &amp; Support"
                            android:textSize="16sp" android:textColor="@color/text_primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginStart="16dp"/>

                    <LinearLayout android:id="@+id/menuLogout"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text=" " android:textSize="16sp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Logout"
                            android:textSize="16sp"
                            android:textColor="@color/error_red"
                            android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textSize="20sp" android:textColor="@color/text_secondary"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <Space android:layout_width="match_parent" android:layout_height="32dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/white"
        android:orientation="horizontal"
        android:elevation="8dp">

        <LinearLayout android:id="@+id/navHome"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/text_secondary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Home" android:textSize="10sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navServices"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_nav_services"
                app:tint="@color/text_secondary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Services" android:textSize="10sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navBookings"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_nav_bookings"
                app:tint="@color/text_secondary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Bookings" android:textSize="10sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navAlerts"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_nav_alerts"
                app:tint="@color/text_secondary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Alerts" android:textSize="10sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navProfile"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_nav_profile"
                app:tint="@color/primary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Profile" android:textSize="10sp" android:textColor="@color/primary"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>